# Copy to .env and fill in. EVERY value here is optional: with no .env at all
# the app runs entirely on mock services against deterministic fake data.

# --- Core --------------------------------------------------------------------
CONFLUENCE_ENV=dev
SECRET_KEY=change-me-in-production
# Offline default is SQLite. For Postgres:
#   postgresql+asyncpg://confluence:confluence@localhost:5432/confluence
DATABASE_URL=sqlite+aiosqlite:///./confluence.db
# Leave unset to use the in-memory catalyst-window store.
REDIS_URL=

# --- Pipeline ----------------------------------------------------------------
POLL_INTERVAL_SECONDS=60
BAR_LOOKBACK=200

# --- Service backends --------------------------------------------------------
# "mock" forces mocks even when keys are present. "auto" uses a real service
# only when its key is set, mock otherwise.
SERVICE_MODE=auto

# --- External providers (all optional) --------------------------------------
ALPACA_API_KEY=
ALPACA_API_SECRET=
UNUSUAL_WHALES_API_KEY=
FINNHUB_API_KEY=
SEC_EDGAR_USER_AGENT=Confluence/0.1 (you@example.com)

# --- Materiality scoring: mock | claude | finbert ----------------------------
MATERIALITY_BACKEND=mock
ANTHROPIC_API_KEY=

# Set true only after the real SEC EDGAR client is implemented.
ENABLE_REAL_FILINGS=false
